---
import Base from '../layouts/Base.astro';
import { homeHref, bookHref } from '../lib/book.mjs';
---

<Base title="Page not found">
  <main id="main" class="not-found page-width">
    <span class="eyebrow">404 / A MISSING DATA POINT</span>
    <h1>
      Find your
      <br />
      <em>place again.</em>
    </h1>
    <p>
      This page is not part of the current edition. Try a search, or go back to the reading path.
    </p>
    <a class="button button-dark" href={homeHref()}>
      Back to the book <span>↗</span>
    </a>
    <a class="text-link" href={bookHref('start-here')}>
      Start here →
    </a>
  </main>
</Base>
