---
type PlateKind =
  'start' | 'guide' | 'causal' | 'offer' | 'price' | 'churn' | 'delivery' | 'lab' | 'publish';
interface Props {
  chapter?: number | string;
  kind?: PlateKind;
  /** Highlights one laboratory stage: 0 generate, 1 check, 2 fit, 3 evaluate, 4 report. */
  stage?: number;
  /** Distinguishes repeated plates on one page so their SVG IDs stay unique. */
  instance?: string;
  compact?: boolean;
}
const { chapter, kind, stage = -1, instance, compact = false } = Astro.props;
const number = Number(chapter) || 1;
const captions = [
  'Find your coordinates',
  'Give the data a shape',
  'Draw an honest boundary',
  'Follow every gradient',
  'Ground every answer',
  'Keep the system accountable',
  'Choose where to go deep',
  'Show your work',
  'Turn evidence into action',
];
const accents = [
  '#accc76',
  '#86b7a6',
  '#a8b7d5',
  '#c4abd0',
  '#d0b47d',
  '#94b5c1',
  '#b8be83',
  '#c4ae94',
  '#a1c97e',
];
// Pages outside the numbered chapters use the same drawing grammar with their own subject.
const plates: Record<
  PlateKind,
  { code: string; accent: string; caption: string; description: string }
> = {
  start: {
    code: 'START',
    accent: '#accc76',
    caption: 'Begin with a small, real win',
    description:
      'You are here. Core, practice and research reading layers lead towards results you can show.',
  },
  guide: {
    code: 'PATH',
    accent: '#86b7a6',
    caption: 'One thread through the whole book',
    description:
      'Chapters 1 to 6 follow one track. Chapter 7 branches into three roles. The job search runs alongside Chapter 6, and Chapter 9 extends the work after Chapter 3.',
  },
  causal: {
    code: '09·A',
    accent: '#a1c97e',
    caption: 'Name the comparison before the estimate',
    description:
      'A population is randomly assigned to treated and control arms. Their outcomes are compared as a difference.',
  },
  offer: {
    code: '09·B',
    accent: '#d0b47d',
    caption: 'Choose by incremental value',
    description:
      'One decision opportunity, offers with positive or negative incremental value, and the best feasible choice.',
  },
  price: {
    code: '09·C',
    accent: '#c4ae94',
    caption: 'Optimise only where prices were tested',
    description:
      'Conversion falls as price rises, while contribution peaks inside the tested price range that informs the decision.',
  },
  churn: {
    code: '09·D',
    accent: '#c4abd0',
    caption: 'Risk is not saveability',
    description:
      'Customers placed by risk of leaving and effect of contact. Only customers a contact helps fill the limited budget.',
  },
  delivery: {
    code: '09·E',
    accent: '#94b5c1',
    caption: 'From decision brief to feedback',
    description:
      'A brief, data, a model, an experiment and operation, with observed outcomes feeding the next brief.',
  },
  lab: {
    code: 'LAB',
    accent: '#a8b7d5',
    caption: 'Reproduce, check, then decide',
    description:
      'A seeded simulator makes the data. Checks reject mismatched hashes. The model fits on training data, the final test is scored once, and reports are written.',
  },
  publish: {
    code: 'EDITIONS',
    accent: '#b8be83',
    caption: 'One source, every edition',
    description:
      'Canonical Markdown is built and checked once, then published as the web book, an EPUB and a PDF.',
  },
};
const labStages = ['GENERATE', 'CHECK', 'FIT', 'EVALUATE', 'REPORT'];
const labCaptions = [
  'Know what the simulated data can claim',
  'Rehearse the failure before it happens',
  'Fit on training data only',
  'Open the final test once',
  'Write down what the results support',
];
const plate = kind ? plates[kind] : undefined;
const labStage = kind === 'lab' && stage >= 0 && stage < labStages.length ? stage : -1;
const code = !plate
  ? String(number).padStart(2, '0')
  : labStage >= 0
    ? `LAB·0${labStage + 1}`
    : plate.code;
const caption = !plate
  ? captions[Math.max(0, Math.min(8, number - 1))]
  : labStage >= 0
    ? labCaptions[labStage]
    : plate.caption;
const accent = plate ? plate.accent : accents[(number - 1) % accents.length];
const label = plate
  ? `${caption}. ${plate.description}`
  : `Chapter ${number}: ${caption}. An abstract data point travels through records, a model, a decision and a feedback loop.`;
const patternId = `plate-grid-${kind ?? number}${instance ? `-${instance}` : ''}${compact ? '-compact' : ''}`;
const grid = [0, 1, 2].flatMap((r) => [0, 1, 2].map((c) => [r, c]));
const guideNodes = [80, 172, 264, 356, 448, 540];
const offers: [string, number, number][] = [
  ['OFFER A', 78, 60],
  ['OFFER B', 110, 120],
  ['OFFER C', 142, -50],
  ['NO OFFER', 174, 0],
];
const churnDots = [
  [150, 100],
  [190, 84],
  [240, 112],
  [300, 92],
  [352, 108],
  [410, 112],
  [160, 170],
  [205, 152],
  [270, 160],
  [330, 148],
  [380, 172],
  [420, 158],
];
const hot = (i: number) => (labStage === i ? 'plate-key' : 'plate-outline');
